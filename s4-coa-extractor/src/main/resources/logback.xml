<configuration>

    <!-- Formato del timestamp nei log -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Console appender (sempre attivo) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!--
        File appender con rotazione giornaliera.
        La directory di log viene impostata tramite variabile di sistema:
            -Dlog.dir=/var/log/coa-extractor
        oppure resta nella directory corrente se non specificata.
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.dir:-./logs}/coa-extractor.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Rotazione giornaliera, compressione automatica -->
            <fileNamePattern>${log.dir:-./logs}/coa-extractor.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <!-- Mantiene 30 giorni di storia -->
            <maxHistory>30</maxHistory>
            <!-- Limite totale su disco: 500 MB -->
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Logger principale dell'applicazione: livello INFO in produzione -->
    <logger name="com.example.coaextractor" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Silenzia i log verbosi di librerie terze -->
    <logger name="org.apache" level="WARN"/>
    <logger name="com.fasterxml" level="WARN"/>

    <!-- Root logger: solo WARNING per tutto il resto -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
