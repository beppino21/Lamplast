<?xml version="1.0" encoding="utf-8"?>
<t:layoutdefinition xmlns:t="http://www.captaincasa.com/controllibrary/t" >

<t:beanprocessing id="g_1" beanbinding="#{d.ListinoBean}" />
<t:rowtitlebar id="g_2" text="Listino Prezzi di Vendita" />

<!-- ═══ SELEZIONE ════════════════════════════════════════════════════════ -->
<t:rowheader id="g_3" >
    <t:field id="g_10" labeltext="Cliente/i:"
             text="#{d.ListinoBean.customerInput}" width="200"
             tooltip="Codici cliente separati da virgola. Vuoto = tutti." />
    <t:coldistance id="g_11" />
    <t:field id="g_12" labeltext="Materiale/i:"
             text="#{d.ListinoBean.materialInput}" width="200"
             tooltip="Codici materiale separati da virgola. Vuoto = tutti." />
    <t:coldistance id="g_13" />
    <t:field id="g_14" labeltext="Data rif.:"
             text="#{d.ListinoBean.referenceDateInput}" width="100"
             tooltip="Data validità (YYYY-MM-DD). Default: oggi." />
    <t:coldistance id="g_15" width="20" />
    <t:button id="g_16" actionListener="#{d.ListinoBean.onExtract}"
              text="Estrai" width="80" stylevariant="ccbig" />
    <t:coldistance id="g_17" />
    <t:button id="g_18" actionListener="#{d.ListinoBean.onReset}"
              text="Reset" width="80" />
</t:rowheader>

<!-- ═══ STATO ════════════════════════════════════════════════════════════ -->
<t:row id="g_20" >
    <t:coldistance id="g_21" width="10" />
    <t:label id="g_22"
             text="#{d.ListinoBean.statusMessage}"
             font="weight:bold;#{d.ListinoBean.hasWarnings ? 'color:#cc6600' : 'color:#007700'}" />
</t:row>
<t:rowdistance id="g_23" height="6" />

<!-- ═══ GRIGLIA ══════════════════════════════════════════════════════════ -->
<t:rowbodypane id="g_30" >
    <t:row id="g_31" >
        <t:pane id="g_32" height="100%" width="100%" >

            <t:row id="g_33" >
                <t:coldistance id="g_34" width="100%" />
                <t:link id="g_35"
                        actionListener="#{d.ListinoBean.gridListino.onEditColumnDetails}"
                        text="Colonne..." />
                <t:coldistance id="g_36" />
                <t:link id="g_37"
                        actionListener="#{d.ListinoBean.gridListino.onOpenGridExportFunctions}"
                        text="Export Excel" />
            </t:row>

            <t:row id="g_40" >
                <t:fixgrid id="g_41"
                        height="100%" width="100%"
                        objectbinding="#{d.ListinoBean.gridListino}"
                        sbvisibleamount="50" >

                    <t:gridcol id="g_50" text="Materiale / Zona" width="220" >
                        <t:label id="g_51" text=".{description}" font=".{rowFont}" />
                    </t:gridcol>

                    <t:gridcol id="g_52" text="Scag. 1" width="100" >
                        <t:label id="g_53" text=".{col1}" font=".{rowFont}" align="right" />
                    </t:gridcol>

                    <t:gridcol id="g_54" text="Scag. 2" width="100" >
                        <t:label id="g_55" text=".{col2}" font=".{rowFont}" align="right" />
                    </t:gridcol>

                    <t:gridcol id="g_56" text="Scag. 3" width="100" >
                        <t:label id="g_57" text=".{col3}" font=".{rowFont}" align="right" />
                    </t:gridcol>

                    <t:gridcol id="g_58" text="Scag. 4" width="100" >
                        <t:label id="g_59" text=".{col4}" font=".{rowFont}" align="right" />
                    </t:gridcol>

                    <t:gridcol id="g_60" text="Scag. 5" width="100" >
                        <t:label id="g_61" text=".{col5}" font=".{rowFont}" align="right" />
                    </t:gridcol>

                    <t:gridcol id="g_62" text="Div." width="45" >
                        <t:label id="g_63" text=".{currency}" />
                    </t:gridcol>

                    <t:gridcol id="g_64" text="Per" width="45" >
                        <t:label id="g_65" text=".{conditionQtyFormatted}" align="right" />
                    </t:gridcol>

                    <t:gridcol id="g_66" text="UM" width="55" >
                        <t:label id="g_67" text=".{conditionUnit}" />
                    </t:gridcol>

                    <t:gridcol id="g_68" text="Da" width="90" >
                        <t:label id="g_69" text=".{validFromFormatted}" />
                    </t:gridcol>

                    <t:gridcol id="g_70" text="A" width="90" >
                        <t:label id="g_71" text=".{validToFormatted}" />
                    </t:gridcol>

                </t:fixgrid>
            </t:row>

        </t:pane>
    </t:row>
</t:rowbodypane>

</t:layoutdefinition>
