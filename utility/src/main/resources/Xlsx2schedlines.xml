<?xml version="1.0" encoding="utf-8"?>
<t:layoutdefinition xmlns:t="http://www.captaincasa.com/controllibrary/t" >

<t:beanprocessing id="g_1" beanbinding="#{d.Xlsx2schedlinesUI}" >
<t:callserverontrigger id="g_pref_rt" actionListener="#{d.Xlsx2schedlinesUI.onStartupRoundtrip}" trigger="#{d.Xlsx2schedlinesUI.startupTrigger}" />
<t:clientlocalstorage id="g_pref_ls" name="lamplastUtilitySapSystem" value="#{d.Xlsx2schedlinesUI.preferredSystemId}" />
</t:beanprocessing>
<t:rowtitlebar id="g_48" text="#{d.Xlsx2schedlinesUI.pageTitle}" />
<t:rowheader id="g_3" >
<t:coldistance id="g_10" />
<t:label id="g_sys_lbl" font="weight:bold" text="Sistema SAP:" />
<t:coldistance id="g_sys_d1" width="8" />
<t:combobox id="g_sys_combo" enabled="#{d.Xlsx2schedlinesUI.systemSelectionEnabled}" flush="true" validvaluesbinding="#{d.Xlsx2schedlinesUI.systemVVB}" value="#{d.Xlsx2schedlinesUI.selectedSystemId}" valuetextmode="TEXT" width="320" />
<t:coldistance id="g_sys_d2" width="40" />
<t:fileuploadbutton id="g_42" actionListener="#{d.Xlsx2schedlinesUI.onLoadXLSX}" fileextensions="xlsx;xls" text="Load XLSX/XLS" width="100+" />
<t:coldistance id="g_71" width="20" />
<t:button id="g_308" actionListener="#{d.Xlsx2schedlinesUI.onDryRun}" text="Verifica (Dry-run)" width="120+" />
<t:coldistance id="g_309" width="20" />
<t:button id="g_253" actionListener="#{d.Xlsx2schedlinesUI.onUpdSchedLine}" text="Aggiorna Ordini" width="100+" />
</t:rowheader>
<t:rowdistance id="g_67" />
<t:row id="g_65" >
<t:pane id="g_sys_bar" background="#{d.Xlsx2schedlinesUI.systemBarBackground}" padding="10" width="100%" >
<t:row id="g_sys_bar_r1" >
<t:label id="g_sys_bar_txt" font="#{d.Xlsx2schedlinesUI.systemBarFont}" foreground="#{d.Xlsx2schedlinesUI.systemBarForeground}" text="#{d.Xlsx2schedlinesUI.systemBarText}" width="100%" />
</t:row>
<t:row id="g_sys_bar_r2" >
<t:label id="g_sys_bar_sub" foreground="#{d.Xlsx2schedlinesUI.systemBarForeground}" text="#{d.Xlsx2schedlinesUI.systemBarSubText}" width="100%" />
</t:row>
</t:pane>
</t:row>
<t:rowdistance id="g_69" />
<t:row id="g_5" />
<t:rowbodypane id="g_24" >
<t:row id="g_31" >
<t:tabbedpane id="g_32" height="100%" width="100%" >
<t:tabbedpanetab id="g_33" text="Dati da file XLSX" >
<t:row id="g_121" >
<t:pane id="g_138" border="#{d.Xlsx2schedlinesUI.bodyBorder}" height="100%" width="100%" >
<t:row id="g_141" >
<t:coldistance id="g_4" width="100%" />
<t:hyperlink id="g_201" enabled="#{d.Xlsx2schedlinesUI.enableFioriVA03}" text="Visualizza Ordine" url="#{d.Xlsx2schedlinesUI.salesOrderNumberFiori}" />
<t:coldistance id="g_255" width="60" />
<t:link id="g_143" actionListener="#{d.Xlsx2schedlinesUI.gridJSONdata.onEditColumnDetails}" text="Colonne..." />
<t:coldistance id="g_149" />
<t:link id="g_145" actionListener="#{d.Xlsx2schedlinesUI.gridJSONdata.onOpenGridExportFunctions}" text="Export" />
</t:row>
<t:row id="g_139" >
<t:rowarea id="banner" visible="#{d.Xlsx2schedlinesUI.bannerVisible}" stylevariant="#{d.Xlsx2schedlinesUI.bannerStylevariant}" >
<t:row id="bannerRow" >
<t:label id="bannerLabel" text="#{d.Xlsx2schedlinesUI.bannerText}" width="100%" />
</t:row>
</t:rowarea>
<t:fixgrid id="g_122" height="100%" objectbinding="#{d.Xlsx2schedlinesUI.gridJSONdata}" width="100%" >
<t:gridcol id="g_rigaexcel" text="Riga Excel" width="60" >
<t:label id="g_rigaexcel_lbl" align="right" text=".{rowIndex}" />
</t:gridcol>
<t:gridcol id="g_123" text="Ordine" width="150" >
<t:label id="g_124" align="right" stylevariant="ccbig" text=".{orderNumber}" />
</t:gridcol>
<t:gridcol id="g_125" text="Pos." width="50" >
<t:label id="g_126" align="right" text=".{itemNumber}" />
</t:gridcol>
<t:gridcol id="g_127" text="Sch." width="50" >
<t:label id="g_128" align="right" text=".{schedLine}" />
</t:gridcol>
<t:gridcol id="g_129" text="Materiale" width="150" >
<t:label id="g_130" text=".{material}" />
</t:gridcol>
<t:gridcol id="g_153" text="Text" width="250" >
<t:label id="g_154" text=".{materialText}" />
</t:gridcol>
<t:gridcol id="g_131" text="Qtà" width="100" >
<t:label id="g_132" align="right" stylevariant="ccbig" text=".{quantity}" />
</t:gridcol>
<t:gridcol id="g_133" text="Data prod." width="150" >
<t:label id="g_151" align="right" stylevariant="ccbig" text=".{schedDate}" />
</t:gridcol>
<t:gridcol id="g_310" text="Azione" width="120" >
<t:label id="g_311" text=".{azione}" />
</t:gridcol>
<t:gridcol id="g_320" text="N° Sch. creata" width="110" >
<t:label id="g_321" align="right" stylevariant="ccbig" text=".{createdScheduleLine}" />
</t:gridcol>
<t:gridcol id="g_314" text="Verifica (Dry-run)" width="100%;250" >
<t:label id="g_315" text=".{dryRunEsito}" />
</t:gridcol>
<t:gridcol id="g_312" text="Esito elaborazione" width="150" >
<t:label id="g_313" text=".{esito}" />
</t:gridcol>
<t:gridcol id="g_178" text="Messaggio SAP" width="100%;200" >
<t:label id="g_179" text=".{errorMessage}" />
</t:gridcol>
</t:fixgrid>
</t:row>
</t:pane>
</t:row>
</t:tabbedpanetab>
<t:tabbedpanetab id="g_114" text="Log" >
<t:row id="g_115" >
<t:textarea id="g_116" flush="true" height="100%" text="#{d.Xlsx2schedlinesUI.logText}" width="100%" readonly="true" />
</t:row>
</t:tabbedpanetab>
<t:tabbedpanetab id="g_181" text="Parametri" >
<t:row id="g_pref_row" >
<t:foldablepane id="g_pref_fp" opened="true" rowdistance="0" text="Sistema SAP predefinito (questo browser)" width="100%" >
<t:row id="g_pref_r1" >
<t:coldistance id="g_pref_d1" width="10" />
<t:label id="g_pref_txt" text="#{d.Xlsx2schedlinesUI.preferredSystemText}" width="100%" />
</t:row>
<t:rowdistance id="g_pref_rd" height="8" />
<t:row id="g_pref_r2" >
<t:coldistance id="g_pref_d2" width="10" />
<t:button id="g_pref_save" actionListener="#{d.Xlsx2schedlinesUI.onSavePreferredSystem}" text="Fissa il sistema attuale come predefinito" width="280+" />
<t:coldistance id="g_pref_d3" width="10" />
<t:button id="g_pref_clear" actionListener="#{d.Xlsx2schedlinesUI.onClearPreferredSystem}" enabled="#{d.Xlsx2schedlinesUI.preferredSystemSet}" text="Rimuovi preferenza" width="150+" />
</t:row>
<t:row id="g_pref_r3" >
<t:coldistance id="g_pref_d4" width="10" />
<t:label id="g_pref_note" stylevariant="ccsmalldesc" text="La scelta è salvata nel browser di questo PC (vale per tutte le sessioni aperte da qui, sopravvive a riavvii e deploy) e ha precedenza su sap.system.default di config.properties." width="100%" />
</t:row>
</t:foldablepane>
</t:row>
<t:rowdistance id="g_pref_rd2" height="12" />
<t:row id="g_236" >
<t:foldablepane id="g_400" opened="true" rowdistance="0" text="Visualizzazione risultati" width="100%" >
<t:row id="g_401" >
<t:coldistance id="g_402" width="10" />
<t:button id="g_403" actionListener="#{d.Xlsx2schedlinesUI.onToggleViewMode}" text="#{d.Xlsx2schedlinesUI.viewModeButtonLabel}" width="250+" />
<t:coldistance id="g_409" width="10" />
<t:label id="g_407" stylevariant="ccsmalldesc" text="In modalità sintetica il Log continua a registrare tutte le righe elaborate." />
</t:row>
</t:foldablepane>
<t:rowdistance id="g_408" height="12" />
<t:foldablepane id="g_237" opened="false" rowdistance="0" text="Label Excel" width="100%" >
<t:row id="g_260" >
<t:field id="g_261" labeltext="Foglio" text="#{d.Xlsx2schedlinesUI.sheetName}" width="100" />
</t:row>
<t:row id="g_238" >
<t:field id="g_239" labeltext="Ordine" text="#{d.Xlsx2schedlinesUI.lblOrdine}" width="100" />
</t:row>
<t:row id="g_240" >
<t:field id="g_241" labeltext="Pos." text="#{d.Xlsx2schedlinesUI.lblPosizione}" width="100" />
</t:row>
<t:row id="g_242" >
<t:field id="g_243" labeltext="Sch." text="#{d.Xlsx2schedlinesUI.lblSchedulazione}" width="100" />
</t:row>
<t:row id="g_244" >
<t:field id="g_245" labeltext="Materiale" text="#{d.Xlsx2schedlinesUI.lblMateriale}" width="100" />
</t:row>
<t:row id="g_246" >
<t:field id="g_247" labeltext="Text" text="#{d.Xlsx2schedlinesUI.lblMaterialeText}" width="100" />
</t:row>
<t:row id="g_248" >
<t:field id="g_249" labeltext="Qtà" text="#{d.Xlsx2schedlinesUI.lblQuantita}" width="100" />
</t:row>
<t:row id="g_250" >
<t:field id="g_251" labeltext="Data prod." text="#{d.Xlsx2schedlinesUI.lblDataProd}" width="100" />
</t:row>
</t:foldablepane>
</t:row>
</t:tabbedpanetab>
</t:tabbedpane>
</t:row>
</t:rowbodypane>

</t:layoutdefinition>